{
  "name": "venturelink",
  "version": "0.0.1",
  "private": true,
  "description": "VentureLink – Startup-VC matchmaking platform monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
